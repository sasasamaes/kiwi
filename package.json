{
  "name": "kiwi",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "api"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "cd api && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev\"",
    "build": "turbo run build",
    "build:api": "cd api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "build:driver": "cd apps/driver && npm run build",
    "build:client": "cd apps/client && npm run build",
    "test": "turbo run test",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:client-bundle:build": "node scripts/check-client-bundle.mjs --build",
    "check:dead-hosts": "node scripts/check-dead-hosts.mjs",
    "test:watch": "turbo run test -- --watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prisma:generate": "cd api && npm run prisma:generate",
    "prisma:migrate": "cd api && npm run prisma:migrate",
    "prisma:studio": "cd api && npm run prisma:studio",
    "deploy": "./scripts/deploy.sh",
    "deploy:web": "cd apps/web && vercel --prod",
    "deploy:driver": "cd apps/driver && vercel --prod",
    "deploy:client": "cd apps/client && vercel --prod",
    "deploy:admin": "cd apps/web && vercel --prod --name kiwi-admin",
    "preview": "turbo run dev --filter='./apps/*'",
    "prepare": ""
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.0.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.400.0"
  }
}
