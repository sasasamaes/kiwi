[TEMPLATE]
# 🥝 Kiwi - Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================
# 🗄️ DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/kiwi_db

# ============================================
# 🔐 AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Rate limit compartido entre instancias (opcional, API)
REDIS_URL=

# ============================================
# 🌐 API CONFIGURATION
# ============================================
API_URL=https://api.kiwicr.express
CORS_ORIGIN=https://negocios.kiwicr.express,https://kiwicr.express,https://repartidores.kiwicr.express

# ============================================
# 💳 PAYMENT GATEWAYS
# ============================================
# OnvoPay (nombres reales que lee el código: onvopay.provider.ts)
ONVO_SECRET_KEY=your_onvo_secret_key
ONVO_PUBLISHABLE_KEY=your_onvo_publishable_key
ONVO_WEBHOOK_SECRET=your_onvo_webhook_secret
ONVO_BASE_URL=https://api.onvopay.com/v1

# Stellar (Crypto): la SECRET key nunca va en el repo; la receiving wallet
# sí se configura en el API (ver api/.env.example)
STELLAR_NETWORK=public
STELLAR_RECEIVING_WALLET=
MERCHANT_URL=https://negocios.kiwicr.express
FRONTEND_URL=https://www.kiwicr.express
CLIENT_URL=https://www.kiwicr.express

# ============================================
# 📱 PUSH NOTIFICATIONS
# ============================================
# Firebase
FIREBASE_PROJECT_ID=kiwi-prod
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ============================================
# 🗺️ MAPS
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# 📧 EMAIL (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# 🔍 MONITORING (Optional)
# ============================================
SENTRY_DSN=your_sentry_dsn
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# 🌍 FRONTEND URLs
# ============================================
NEXT_PUBLIC_API_URL=https://api.kiwicr.express/api
NEXT_PUBLIC_SOCKET_URL=https://api.kiwicr.express
NEXT_PUBLIC_APP_URL=https://negocios.kiwicr.express
NEXT_PUBLIC_MERCHANT_URL=https://negocios.kiwicr.express
NEXT_PUBLIC_DRIVER_URL=https://repartidores.kiwicr.express
NEXT_PUBLIC_CLIENT_URL=https://kiwicr.express
