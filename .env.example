# Database
DATABASE_URL="postgresql://user:password@localhost:5432/delivery_app"

# Auth (NextAuth)
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OnvoPay (Pagos)
ONVO_API_KEY="your-onvo-api-key"
ONVO_WEBHOOK_SECRET="your-webhook-secret"
ONVO_ENVIRONMENT="sandbox" # sandbox or production

# Google Maps
GOOGLE_MAPS_API_KEY="your-google-maps-key"

# Stellar (Crypto Payments)
STELLAR_SECRET_KEY="your-stellar-secret-key"
STELLAR_PUBLIC_KEY="your-stellar-public-key"

# Sentry (Error Tracking - Optional)
SENTRY_DSN=""

# PostHog (Analytics - Optional)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DRIVER_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"

# Redis (Cache - Optional)
REDIS_URL="redis://localhost:6379"
