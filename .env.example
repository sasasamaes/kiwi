[TEMPLATE]
# 🥝 Kiwi - Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================
# 🗄️ DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/kiwi_db

# ============================================
# 🔐 AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRATION=7d

# ============================================
# 🌐 API CONFIGURATION
# ============================================
API_URL=https://api.kiwicr.express
CORS_ORIGIN=https://negocios.kiwicr.express,https://kiwicr.express,https://repartidores.kiwicr.express

# ============================================
# 💳 PAYMENT GATEWAYS
# ============================================
# OnvoPay
ONVOPAY_API_KEY=your_onvopay_api_key
ONVOPAY_SECRET_KEY=your_onvopay_secret_key
ONVOPAY_WEBHOOK_SECRET=your_onvopay_webhook_secret

# Stellar (Crypto)
STELLAR_SECRET_KEY=your_stellar_secret_key
STELLAR_NETWORK=public

# ============================================
# 📱 PUSH NOTIFICATIONS
# ============================================
# Firebase
FIREBASE_PROJECT_ID=kiwi-prod
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ============================================
# 🗺️ MAPS
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# 📧 EMAIL (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# 🔍 MONITORING (Optional)
# ============================================
SENTRY_DSN=your_sentry_dsn
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# 🌍 FRONTEND URLs
# ============================================
NEXT_PUBLIC_API_URL=https://api.kiwicr.express/api
NEXT_PUBLIC_SOCKET_URL=https://api.kiwicr.express
NEXT_PUBLIC_APP_URL=https://negocios.kiwicr.express
NEXT_PUBLIC_MERCHANT_URL=https://negocios.kiwicr.express
NEXT_PUBLIC_DRIVER_URL=https://repartidores.kiwicr.express
NEXT_PUBLIC_CLIENT_URL=https://kiwicr.express
