generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table
model User {
  id           String     @id @default(uuid())
  email        String?    @unique
  // El teléfono NO es unique global: la misma persona puede tener cuenta de
  // cliente, comercio y repartidor con el mismo número (distinto correo).
  // La unicidad es (phone, role) y se valida en el servicio.
  phone        String?
  passwordHash String?    @map("password_hash")
  role         Role       @default(merchant)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Sesiones: se invalida en logout global (los access viven 15 min).
  tokenVersion Int @default(0) @map("token_version")

  // Throttle de login por cuenta EN DB (sobrevive restarts e instancias;
  // el Map en memoria solo cubre emails inexistentes).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  loginLockedUntil    DateTime? @map("login_locked_until")

  // Código de referido con el que se registró (KIKO, WICHO, …). Opcional,
  // se guarda en mayúsculas para contar usos por código en el admin.
  referredByCode String? @map("referred_by_code")

  // Relations
  merchantProfile     MerchantProfile?
  driverProfile       DriverProfile?
  customerProfile     CustomerProfile?
  customerAddresses   CustomerAddress[]
  kycVerification     KYCVerification?
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  topicPreferences    TopicPreference[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  customerOrders      Order[]              @relation("CustomerOrders")
  merchantFollows     MerchantFollow[]

  @@index([phone])
  @@index([referredByCode])
  @@map("users")
}

// Refresh tokens opacos rotativos (un uso cada uno). Solo viaja el hash:
// si la DB se filtra, los tokens vivos no sirven sin el valor original.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// Token de recupero de contraseña: se guarda solo el hash (sha256). Un solo
// uso, expira en 1 hora. El link viaja por email; el token crudo jamás se
// persiste.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// Invitación de venta en campo (admin): el vendedor anota email (+ teléfono
// opcional) negocio por negocio y el admin manda el correo de invitación a
// Kiwi Comercio (merchant) o a Kiwi Repartidores (driver). El link lleva un
// token crudo; en DB solo vive su hash sha256 (igual que el recupero).
// Expira a los 30 días. Al registrarse con ese email+rol se marca accepted.
model Invitation {
  id         String    @id @default(uuid())
  email      String
  phone      String?
  // Nombre del negocio (merchant) o de la persona (driver). Solo etiqueta
  // para el vendedor; no se usa en el registro.
  name       String?
  role       String // merchant | driver
  tokenHash  String    @unique @map("token_hash")
  status     String    @default("pending") // pending | accepted | revoked
  expiresAt  DateTime  @map("expires_at")
  createdBy  String?   @map("created_by") // userId del admin/vendedor
  sentAt     DateTime? @map("sent_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([role, status, createdAt])
  @@index([email, role])
  @@map("invitations")
}

// Link de reparto del comercio: el comercio elige barrio + método de pago
// (cash, crédito o facturación semanal — él paga el viaje) y comparte el
// link con el cliente, que solo completa sus datos y la dirección exacta.
// Token crudo solo en la URL; en DB solo su hash sha256 (igual que las
// invitaciones). Un solo uso: al crear el pedido se marca consumed con el
// orderId, y los reintentos devuelven ese mismo pedido. Expira a los 7 días.
model DeliveryLink {
  id            String          @id @default(uuid())
  merchantId    String          @map("merchant_id")
  merchant      MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // Zona elegida por el comercio (id de DeliveryZone; el precio siempre se
  // recalcula en servidor, nunca se confía en el query string).
  deliveryZone  String          @map("delivery_zone")
  // Método con el que paga el comercio: cash | credit | weekly_invoice
  paymentMethod String          @map("payment_method")
  tokenHash     String          @unique @map("token_hash")
  status        String          @default("pending") // pending | consumed | cancelled
  expiresAt     DateTime        @map("expires_at")
  consumedAt    DateTime?       @map("consumed_at")
  orderId       String?         @map("order_id")
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy     String?         @map("created_by") // userId del comercio que lo creó
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([merchantId, status, createdAt])
  @@map("delivery_links")
}

// Códigos de referido (KIKO, WICHO, …): el que se registra puede anotar uno
// y ver la oferta que le toca según su app. `offers` es
// { customer?: {title, detail}, driver?: {…}, merchant?: {…} } — cada rol con
// su oferta y el admin los edita sin migraciones.
model ReferralCode {
  id        String   @id @default(uuid())
  code      String   @unique
  active    Boolean  @default(true)
  offers    Json     @default("{}")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("referral_codes")
}

// Registro de cada envío masivo/informativo del equipo de ventas (email y/o
// WhatsApp): qué se mandó, a cuántos y quién lo disparó. Auditoría mínima.
model BroadcastLog {
  id        String   @id @default(uuid())
  channel   String // email | whatsapp | both
  audience  String // merchant | driver | customer | mixed | custom
  subject   String?
  preview   String? // primeros 200 caracteres del cuerpo
  count     Int      @default(0)
  failed    Int      @default(0)
  sentBy    String?  @map("sent_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("broadcast_logs")
}

// Visita de venta en campo: presentación que se hizo en cada negocio, con
// qué se habló y cuándo volver (seguimiento). El vendedor la carga desde el
// teléfono o el admin; si deja invitación queda el link a ella.
model SalesVisit {
  id           String    @id @default(uuid())
  businessName String    @map("business_name")
  contactName  String?   @map("contact_name")
  email        String?
  phone        String?
  address      String?
  citySlug     String    @default("nicoya") @map("city_slug")
  // pending | interested | invited | registered | not_interested
  outcome      String    @default("pending")
  notes        String?
  followUpAt   DateTime? @map("follow_up_at")
  invitationId String?   @map("invitation_id")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([outcome, followUpAt])
  @@index([businessName])
  @@map("sales_visits")
}

// Historial de avisos push a seguidores por comercio ("mañana vendo
// rollos"). Fuente del cupo semanal: 4 gratis/semana (lunes a domingo CR);
// lo extra consume pushCredits. free=true = contra el cupo gratis.
model PushAnnouncement {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  title      String
  body       String
  reached    Int      @default(0)
  free       Boolean  @default(true)
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([merchantId, createdAt])
  @@map("push_announcements")
}

// Lista de espera por cobertura: gente que quiere usar Kiwi donde aún no
// operamos (registro fuera de zona o pedido bloqueado). Cuando se abre una
// ciudad, el admin les avisa por correo (notified). Sin FK a City a propósito:
// la ciudad pedida puede no existir todavía como fila operativa.
model CoverageInterest {
  id        String   @id @default(uuid())
  email     String?
  phone     String?
  // Ciudad pedida en texto ("Liberia", "San Jose"...). Normalizada simple.
  city      String
  zone      String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  // register-customer | register-merchant | register-driver | order-blocked
  source    String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([city, notified, createdAt])
  @@index([email, city])
  @@map("coverage_interests")
}

enum Role {
  merchant
  driver
  admin
  customer
}

enum UserStatus {
  active
  inactive
  pending
}

// Merchant profiles
model MerchantProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  businessName String   @map("business_name")
  address      String
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  logoUrl      String?  @map("logo_url")
  description  String?
  openingHours Json?    @map("opening_hours")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Redes sociales del negocio (links que ve el cliente en el menú).
  // { instagram, facebook, tiktok, whatsapp }: URLs https ya normalizadas.
  socials Json? @map("socials")

  // Ciudad operativa (multiciudad: nicoya hoy, liberia después).
  // Default nicoya para no romper datos existentes.
  citySlug String @default("nicoya") @map("city_slug")

  // Visible en la lista pública de la app cliente. Los comercios de test
  // (u ocultos por admin) siguen activos: QR, menú y pedidos funcionan.
  isListed Boolean @default(true) @map("is_listed")

  // Cocina casera: pequeño emprendedor (antojos de casa, menú del día).
  // Lo marca el admin; habilita sección propia, preventa y comisión reducida.
  isHomeCook Boolean @default(false) @map("is_home_cook")

  // Cobra con tarjeta/SINPE vía Onvo en la app cliente. El admin lo activa
  // cuando el comercio pasa el KYC de Onvo. Sin esto solo efectivo (y crypto).
  cardPaymentsEnabled Boolean @default(false) @map("card_payments_enabled")

  // Métodos que el propio comercio puede prender/apagar en su perfil.
  // cashEnabled: efectivo (independiente de Onvo).
  // sinpeEnabled: SINPE Móvil vía Onvo (solo aplica si cardPaymentsEnabled/Onvo activo).
  cashEnabled  Boolean @default(true) @map("cash_enabled")
  sinpeEnabled Boolean @default(true) @map("sinpe_enabled")

  // Facturación semanal pospago: solo la activa el admin por comercio.
  // El comercio paga contra uso y Kiwi hace el corte/cobro cada semana.
  weeklyBillingEnabled Boolean @default(false) @map("weekly_billing_enabled")

  // Onvo marketplace: cuenta conectada del comercio para split automático.
  // onboardingStatus: pending_onboarding | awaiting_approval | active | ...
  onvoConnectedAccountId String? @map("onvo_connected_account_id")
  onvoOnboardingStatus   String? @map("onvo_onboarding_status")

  // Categoría del negocio (filtros de la app cliente). Se autotaguea por
  // nombre al registrar; el comercio la puede cambiar después.
  category MerchantCategory @default(restaurante)

  // KYC
  kycStatus     KYCStatus @default(pending) @map("kyc_status")
  kycVerifiedAt DateTime? @map("kyc_verified_at")

  // Crédito prepago: el admin recarga, el comercio lo gasta en envíos
  // (viaje + plataforma). Solo envío — los productos los cobra el comercio.
  creditBalance Decimal @default(0) @map("credit_balance") @db.Decimal(10, 2)

  // Modo prueba (demos con comercios): el admin lo habilita por tiempo
  // limitado. Vencido el plazo, crear pedidos test se rechaza.
  testOrdersEnabled Boolean @default(false) @map("test_orders_enabled")
  testOrdersUntil   DateTime? @map("test_orders_until")

  // Avisos push extra a seguidores (más allá de los 4 gratis/semana). Los
  // otorga el admin (comprados o por acuerdo); cada aviso extra consume 1.
  pushCredits Int @default(0) @map("push_credits")

  // Relations
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  city            City                @relation(fields: [citySlug], references: [slug])
  orders          Order[]
  menuItems       MenuItem[]
  kiosks          MerchantKiosk[]
  favoriteDrivers FavoriteDriver[]
  followers       MerchantFollow[]
  ratings         Rating[]
  creditLedger    CreditTransaction[]
  creditTopups    CreditTopup[]
  invoices        MerchantInvoice[]
  deliveryLinks   DeliveryLink[]
  campaigns       AdCampaign[]
  broadcasts      OfferBroadcast[]

  @@index([citySlug])
  @@index([citySlug, category])
  @@map("merchant_profiles")
}

// Libreta de direcciones del cliente (estilo Rappi): varios lugares
// guardados ("Casa", "Casa de mamá"…) para elegir dónde entregar sin
// escribir todo cada vez. El perfil conserva UNA dirección default.
model CustomerAddress {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  label        String
  address      String
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  deliveryZone String?  @map("delivery_zone")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_addresses")
}

// Perfil público del cliente final (rol customer). Minimización Ley 8968:
// solo nombre + dirección de entrega + ciudad/zona para segmentar ofertas.
model CustomerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  fullName       String?  @map("full_name")
  defaultAddress String?  @map("default_address")
  citySlug       String   @default("nicoya") @map("city_slug")
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  deliveryZone   String?  @map("delivery_zone")
  // Foto de perfil (URL https de Cloudinary) o emoji elegido. Opcional.
  avatarUrl      String?  @map("avatar_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [citySlug], references: [slug])

  @@index([citySlug])
  @@map("customer_profiles")
}

// Catálogo de ciudades operativas. Nicoya activa hoy; Liberia y otras se
// activan sin migraciones (solo insert + catálogo de zonas en código).
model City {
  slug      String   @id
  name      String
  centerLat Decimal? @map("center_lat") @db.Decimal(10, 8)
  centerLng Decimal? @map("center_lng") @db.Decimal(11, 8)
  radiusKm  Int      @default(10) @map("radius_km")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  merchants  MerchantProfile[]
  customers  CustomerProfile[]
  campaigns  AdCampaign[]
  broadcasts OfferBroadcast[]

  @@map("cities")
}

// Seguidores de un comercio (clientes que quieren avisos de ventas y
// reposiciones). El push respeta el topic `customer.follows` (opt-out).
model MerchantFollow {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  merchantId String   @map("merchant_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([merchantId])
  @@map("merchant_follows")
}

// Campaña de publicidad del comercio (destacado primero o banner home).
model AdCampaign {
  id           String           @id @default(uuid())
  merchantId   String           @map("merchant_id")
  citySlug     String           @default("nicoya") @map("city_slug")
  type         AdCampaignType
  title        String?
  imageUrl     String?          @map("image_url")
  startsAt     DateTime         @map("starts_at")
  endsAt       DateTime         @map("ends_at")
  status       AdCampaignStatus @default(pending)
  pricePerDay  Decimal          @map("price_per_day") @db.Decimal(10, 2)
  totalCharged Decimal          @default(0) @map("total_charged") @db.Decimal(10, 2)
  createdBy    String?          @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  city     City            @relation(fields: [citySlug], references: [slug])
  events   AdEvent[]

  @@index([citySlug, status, startsAt, endsAt])
  @@index([merchantId, status])
  @@map("ad_campaigns")
}

enum AdCampaignType {
  spotlight // aparecer primero en el feed
  banner // carrusel home_top
}

enum AdCampaignStatus {
  pending
  active
  paused
  ended
  rejected
}

// Push de ofertas segmentado por ciudad (+ zona opcional). Nace pending,
// el admin aprueba y al enviarse descuenta de creditBalance (tier premium).
model OfferBroadcast {
  id             String      @id @default(uuid())
  merchantId     String      @map("merchant_id")
  citySlug       String      @default("nicoya") @map("city_slug")
  zoneId         String?     @map("zone_id")
  title          String
  body           String
  imageUrl       String?     @map("image_url")
  linkMerchantId String?     @map("link_merchant_id")
  status         OfferStatus @default(pending)
  costCharged    Decimal     @default(0) @map("cost_charged") @db.Decimal(10, 2)
  approvedBy     String?     @map("approved_by")
  sentAt         DateTime?   @map("sent_at")
  scheduledAt    DateTime?   @map("scheduled_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  city     City            @relation(fields: [citySlug], references: [slug])
  events   AdEvent[]

  @@index([citySlug, status])
  @@index([merchantId, status])
  @@map("offer_broadcasts")
}

enum OfferStatus {
  pending
  approved
  sending
  sent
  rejected
  cancelled
}

// Métrica auditable: impresiones/clicks/push enviados. Costo queda en 0 en
// MVP día-fijo; sirve para reportar al comercio y para futuro por-click.
model AdEvent {
  id          String   @id @default(uuid())
  campaignId  String?  @map("campaign_id")
  broadcastId String?  @map("broadcast_id")
  type        String // impression | click | push_sent | push_open
  cost        Decimal  @default(0) @db.Decimal(10, 2)
  userId      String?  @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  campaign  AdCampaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  broadcast OfferBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([broadcastId, createdAt])
  @@map("ad_events")
}

// Categorías de negocio para los filtros de la app cliente.
enum MerchantCategory {
  restaurante
  soda
  pizzeria
  cafe_brunch
  panaderia
  mariscos
  comida_rapida
  saludable
  cocina_casera
  bar
  otro
}

// Libro mayor del crédito prepago (auditable: toda recarga y gasto queda aquí)
model CreditTransaction {
  id         String                @id @default(uuid())
  merchantId String                @map("merchant_id")
  amount     Decimal               @db.Decimal(10, 2) // + recarga, − gasto
  kind       CreditTransactionKind
  reason     String?
  orderId    String?               @map("order_id")
  createdBy  String?               @map("created_by") // userId del admin que recargó
  createdAt  DateTime              @default(now()) @map("created_at")

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@map("credit_transactions")
}

enum CreditTransactionKind {
  recharge
  spend
  refund
  adjustment
}

// Recarga de crédito con tarjeta (autogestión del comercio vía Onvo
// Checkout): nace pendiente y recién acredita cuando el webhook o el
// polling confirman el cobro. El gate anti doble-acreditación es el
// updateMany condicionado en completeTopup.
model CreditTopup {
  id         String        @id @default(uuid())
  merchantId String        @map("merchant_id")
  amount     Decimal       @db.Decimal(10, 2)
  currency   String        @default("CRC")
  status     PaymentStatus @default(pending)

  onvoSessionId   String? @map("onvo_session_id")
  onvoPaymentId   String? @map("onvo_payment_id")
  onvoCheckoutUrl String? @map("onvo_checkout_url")

  createdBy   String?   @map("created_by") // userId del comercio que la inició
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@index([onvoSessionId], map: "credit_topups_onvo_session_id_idx")
  @@index([onvoPaymentId], map: "credit_topups_onvo_payment_id_idx")
  @@map("credit_topups")
}

// Corte semanal de facturación pospago por comercio (pedidos con pago
// weekly_invoice ya entregados). Las líneas son los Payment enlazados por
// invoiceId; el monto queda congelado al generar (snapshot anti re-cálculo).
model MerchantInvoice {
  id         String          @id @default(uuid())
  merchantId String          @map("merchant_id")
  merchant   MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Semana mar–lun CR (igual corte que la planilla de repartidores).
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  trips  Int     @default(0)
  // Suma congelada de los viajes (basePrice) al generar el corte.
  amount Decimal @map("amount") @db.Decimal(10, 2)

  status InvoiceStatus @default(pending)
  paidAt DateTime?     @map("paid_at")

  createdBy String?  @map("created_by") // userId del admin que generó
  createdAt DateTime @default(now()) @map("created_at")

  payments Payment[]

  @@unique([merchantId, periodStart], map: "merchant_invoices_merchant_period_uk")
  @@index([merchantId, status, periodStart], map: "merchant_invoices_merchant_status_idx")
  @@map("merchant_invoices")
}

enum InvoiceStatus {
  pending
  paid
}

// Ajustes de plataforma (admin). Clave-valor: lo que ves en /admin/settings
// se guarda acá — nada vive solo en el navegador.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// Historial mensual de escenarios: proyección fijada por el admin al cierre
// de cada mes, para comparar contra lo que realmente pasó después.
model ScenarioSnapshot {
  id                  String   @id @default(uuid())
  month               String   @unique
  ordersPerDay        Int      @map("orders_per_day")
  expectedTrip        Float    @map("expected_trip")
  commissionPct       Float    @map("commission_pct")
  operations          Json
  projectedCommission Float    @map("projected_commission")
  projectedNet        Float    @map("projected_net")
  note                String?
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("scenario_snapshots")
}

// Driver profiles
model DriverProfile {
  id                     String       @id @default(uuid())
  userId                 String       @unique @map("user_id")
  fullName               String       @map("full_name")
  photoUrl               String?      @map("photo_url")
  // Onvo marketplace: cuenta conectada del repartidor (flete/express).
  // onboardingStatus: pending_onboarding | awaiting_approval | active | ...
  onvoConnectedAccountId String?      @map("onvo_connected_account_id")
  onvoOnboardingStatus   String?      @map("onvo_onboarding_status")
  vehicleType            VehicleType  @map("vehicle_type")
  vehiclePlate           String?      @map("vehicle_plate")
  level                  DriverLevel  @default(bronce)
  rating                 Decimal      @default(5.0) @db.Decimal(3, 2)
  totalTrips             Int          @default(0) @map("total_trips")
  status                 DriverStatus @default(offline)
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  // KYC
  kycStatus     KYCStatus @default(pending) @map("kyc_status")
  kycVerifiedAt DateTime? @map("kyc_verified_at")

  // Última ubicación conocida (targeting de alertas por proximidad).
  // Backfill histórico: centro de Nicoya; lastSeenAt null = nunca reportó.
  lastLat    Decimal?  @map("last_lat") @db.Decimal(10, 8)
  lastLng    Decimal?  @map("last_lng") @db.Decimal(11, 8)
  lastSeenAt DateTime? @map("last_seen_at")

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules       DriverSchedule[]
  orders          Order[]
  proposals       DriverProposal[]
  favoriteDrivers FavoriteDriver[]
  ratings         Rating[]
  incentives      DriverIncentive[]
  withdrawals     Withdrawal[]
  debtPayments    DebtPayment[]
  debtLinks       DebtParticipant[]
  debtExpenses    DebtExpense[]
  rentals         RentalContract[]

  @@index([status, lastLat, lastLng], map: "driver_profiles_targeting_idx")
  @@map("driver_profiles")
}

enum VehicleType {
  motorcycle // Moto
  motorized_bike // Bici moto
  bicycle // Bici
  car // Carro
  truck // Camión
}

enum DriverLevel {
  bronce
  plata
  oro
  diamante
  vip
}

enum DriverStatus {
  offline
  available
  busy
}

// KYC Verification
model KYCVerification {
  id     String    @id @default(uuid())
  userId String    @unique @map("user_id")
  status KYCStatus @default(pending)

  // Identity Documents
  idType     String? @map("id_type") // cedula, passport, etc.
  idNumber   String? @map("id_number")
  idFrontUrl String? @map("id_front_url")
  idBackUrl  String? @map("id_back_url")

  // Selfie Verification
  selfieUrl      String? @map("selfie_url")
  selfieVerified Boolean @default(false) @map("selfie_verified")

  // Driver License (for drivers)
  licenseNumber String?   @map("license_number")
  licenseExpiry DateTime? @map("license_expiry")
  licenseUrl    String?   @map("license_url")

  // Vehicle Documents (for drivers)
  vehicleRegisterUrl String? @map("vehicle_register_url")
  insuranceUrl       String? @map("insurance_url")

  // Business Documents (for merchants)
  businessLicenseUrl String? @map("business_license_url")
  taxId              String? @map("tax_id")

  // Verification metadata
  verifiedAt      DateTime? @map("verified_at")
  verifiedBy      String?   @map("verified_by")
  rejectionReason String?   @map("rejection_reason")
  notes           String?

  // Didit hosted verification (KYC automático por documento + liveness).
  diditSessionId  String?   @unique @map("didit_session_id")
  diditStatus     String?   @map("didit_status")
  diditUrl        String?   @map("didit_url")
  diditVerifiedAt DateTime? @map("didit_verified_at")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "kyc_verifications_status_created_idx")
  @@map("kyc_verifications")
}

enum KYCStatus {
  pending
  documents_submitted
  under_review
  approved
  rejected
  expired
}

// Driver schedules
model DriverSchedule {
  id          String   @id @default(uuid())
  driverId    String   @map("driver_id")
  dayOfWeek   Int      @map("day_of_week")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  isAvailable Boolean  @default(true) @map("is_available")

  // Relations
  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_schedules")
}

// Orders
model Order {
  id         String      @id @default(uuid())
  merchantId String      @map("merchant_id")
  driverId   String?     @map("driver_id")
  customerId String?     @map("customer_id")
  status     OrderStatus @default(pending)
  orderType  OrderType   @map("order_type")

  // Schedule
  scheduledDate DateTime? @map("scheduled_date")
  scheduledTime String?   @map("scheduled_time")

  // Recogida rápida (botón flotante del comercio): hora estimada en que la
  // comida está lista y el repartidor debe ir a recoger. Solo inmediatos.
  readyAt DateTime? @map("ready_at")

  // Addresses
  pickupAddress   String   @map("pickup_address")
  pickupLat       Decimal? @map("pickup_lat") @db.Decimal(10, 8)
  pickupLng       Decimal? @map("pickup_lng") @db.Decimal(11, 8)
  deliveryAddress String   @map("delivery_address")
  deliveryLat     Decimal? @map("delivery_lat") @db.Decimal(10, 8)
  deliveryLng     Decimal? @map("delivery_lng") @db.Decimal(11, 8)

  // Pricing
  distanceKm         Decimal? @map("distance_km") @db.Decimal(5, 2)
  deliveryZone       String?  @map("delivery_zone")
  basePrice          Decimal  @map("base_price") @db.Decimal(10, 2)
  commission         Decimal  @db.Decimal(10, 2)
  // Tasa aplicada: 0.10 con crédito prepago, 0.15 con otros medios
  commissionRate     Decimal  @default(0.10) @map("commission_rate") @db.Decimal(4, 3)
  driverPayout       Decimal  @map("driver_payout") @db.Decimal(10, 2)
  totalAmount        Decimal  @map("total_amount") @db.Decimal(10, 2)
  // Flete (fase 1: encomiendas)
  productsTotal      Decimal  @default(0) @map("products_total") @db.Decimal(10, 2)
  kind               String   @default("food") @map("kind")
  packageDescription String?  @map("package_description")
  packageSize        String?  @map("package_size")
  declaredValue      Decimal? @map("declared_value") @db.Decimal(10, 2)
  weightKg           Decimal? @map("weight_kg") @db.Decimal(8, 2)

  // Mandados (cliente pide compra presencial): estimado, factura real,
  // fee 10% (mitad bonus repartidor, mitad Kiwi). productsTotal lleva la
  // compra (estimado → factura) para que total y reembolso cuadren.
  isMandado        Boolean  @default(false) @map("is_mandado")
  purchaseStore    String?  @map("purchase_store")
  purchaseEstimate Decimal? @map("purchase_estimate") @db.Decimal(10, 2)
  receiptAmount    Decimal? @map("receipt_amount") @db.Decimal(10, 2)
  extraFee         Decimal  @default(0) @map("extra_fee") @db.Decimal(10, 2)

  // Instructions
  specialInstructions String? @map("special_instructions")

  // Contacto del comprador (pedidos de link público/invitado). El tracking
  // público NO lo expone; solo el comercio dueño y el driver asignado.
  customerName  String? @map("customer_name")
  customerPhone String? @map("customer_phone")

  // Efectivo: con cuánto paga el cliente (para llevar el vuelto listo).
  // Null = no indicó. El vuelto se deriva: cashTendered − totalAmount.
  cashTendered Decimal? @map("cash_tendered") @db.Decimal(10, 2)

  // Pedido de prueba (modo demo con comercios): no mueve crédito del
  // comercio ni cuenta como ganancia; solo practican el flujo con los
  // repartidores piloto. Los agregados de plata lo excluyen por defecto.
  isTest Boolean @default(false) @map("is_test")

  // Origen: client_app (link público / app cliente) vs merchant_panel
  // (creado por el comercio en el dashboard). La página de comandas muestra
  // solo client_app.
  origin String @default("merchant_panel") @map("origin")

  // Anti-duplicados: el comercio con wifi caído reintentaba "Crear Pedido"
  // y cada POST creaba un pedido distinto. El frontend manda una key única
  // por intento (header Idempotency-Key + body): si ya existe un pedido de
  // este comercio con esa key, se devuelve el existente sin crear otro.
  idempotencyKey String? @map("idempotency_key")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  assignedAt  DateTime? @map("assigned_at")
  pickedUpAt  DateTime? @map("picked_up_at")
  deliveredAt DateTime? @map("delivered_at")

  // Asignación con aceptación: deadline del driver y ventana de concurso.
  acceptanceExpiresAt DateTime? @map("acceptance_expires_at")
  contestStartedAt    DateTime? @map("contest_started_at")
  contestEndsAt       DateTime? @map("contest_ends_at")

  // Evidencia fotográfica 1+1 (obligatoria para avanzar).
  pickupProofPhotoUrl   String?   @map("pickup_proof_photo_url")
  pickupProofAt         DateTime? @map("pickup_proof_at")
  deliveryProofPhotoUrl String?   @map("delivery_proof_photo_url")
  deliveryProofAt       DateTime? @map("delivery_proof_at")

  // Relations
  merchant        MerchantProfile  @relation(fields: [merchantId], references: [id])
  driver          DriverProfile?   @relation(fields: [driverId], references: [id])
  customer        User?            @relation("CustomerOrders", fields: [customerId], references: [id])
  proposals       DriverProposal[]
  items           OrderItem[]
  payment         Payment?
  ratings         Rating[]
  withdrawalItems WithdrawalItem[]
  deliveryLinks   DeliveryLink[]

  @@unique([merchantId, idempotencyKey], map: "orders_merchant_idempotency_uk")
  @@index([merchantId, origin, status, createdAt], map: "orders_merchant_origin_status_created_idx")
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([isTest])
  @@index([driverId, status])
  @@index([driverId, createdAt])
  @@index([customerId, status, createdAt], map: "orders_customer_status_created_idx")
  @@index([status, createdAt])
  @@index([merchantId, status, createdAt], map: "orders_merchant_status_created_idx")
  @@index([driverId, status, createdAt], map: "orders_driver_status_created_idx")
  @@index([driverId, status, deliveredAt], map: "orders_driver_status_delivered_idx")
  @@index([status, deliveredAt], map: "orders_status_delivered_idx")
  @@map("orders")
}

enum OrderStatus {
  pending
  awaiting_payment
  driver_proposals
  assigned
  pending_acceptance
  in_transit_to_pickup
  picked_up
  in_transit_to_delivery
  delivered
  cancelled
  no_driver
}

enum OrderType {
  immediate
  scheduled
}

// Driver proposals (for scheduled orders)
model DriverProposal {
  id               String         @id @default(uuid())
  orderId          String         @map("order_id")
  driverId         String         @map("driver_id")
  status           ProposalStatus @default(pending)
  estimatedArrival String?        @map("estimated_arrival")
  message          String?
  createdAt        DateTime       @default(now()) @map("created_at")

  // Relations
  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([orderId, driverId], map: "driver_proposals_order_driver_idx")
  @@index([orderId, status], map: "driver_proposals_order_status_idx")
  @@map("driver_proposals")
}

enum ProposalStatus {
  pending
  accepted
  rejected
}

// Payments
model Payment {
  id       String        @id @default(uuid())
  orderId  String        @unique @map("order_id")
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("CRC")
  method   PaymentMethod
  status   PaymentStatus @default(pending)

  // OnvoPay
  onvoPaymentId   String? @map("onvo_payment_id")
  onvoCheckoutUrl String? @map("onvo_checkout_url")
  // Checkout hospedado (one-time-link): la sesión es el objeto de cobro;
  // el intent real llega después por webhook y se guarda en onvoPaymentId.
  onvoSessionId   String? @map("onvo_session_id")

  // Crypto
  cryptoCoin          String?  @map("crypto_coin")
  cryptoNetwork       String?  @map("crypto_network")
  cryptoWalletAddress String?  @map("crypto_wallet_address")
  cryptoTxHash        String?  @unique @map("crypto_tx_hash")
  cryptoAmount        Decimal? @map("crypto_amount") @db.Decimal(10, 6)
  exchangeRate        Decimal? @map("exchange_rate") @db.Decimal(10, 4)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Facturación semanal del comercio: la línea queda enlazada al corte.
  invoiceId String?          @map("invoice_id")
  invoice   MerchantInvoice? @relation(fields: [invoiceId], references: [id])

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "payments_status_created_idx")
  @@index([method, status, createdAt], map: "payments_method_status_created_idx")
  @@index([invoiceId], map: "payments_invoice_id_idx")
  @@index([onvoPaymentId], map: "payments_onvo_payment_id_idx")
  @@index([onvoSessionId], map: "payments_onvo_session_id_idx")
  @@index([cryptoWalletAddress, status], map: "payments_wallet_status_idx")
  @@map("payments")
}

enum PaymentMethod {
  onvopay_card
  onvopay_sinpe
  crypto
  cash
  credit
  // Pos-pago del comercio: se acumula y Kiwi lo cobra en el corte semanal.
  weekly_invoice
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

// Ratings
model Rating {
  id               String   @id @default(uuid())
  orderId          String   @map("order_id")
  driverId         String   @map("driver_id")
  merchantId       String   @map("merchant_id")
  rating           Int
  comment          String?
  onTime           Boolean? @map("on_time")
  carefulWithOrder Boolean? @map("careful_with_order")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver   DriverProfile   @relation(fields: [driverId], references: [id])
  merchant MerchantProfile @relation(fields: [merchantId], references: [id])

  @@index([orderId], map: "ratings_order_idx")
  @@index([driverId, createdAt], map: "ratings_driver_created_idx")
  @@index([merchantId, createdAt], map: "ratings_merchant_created_idx")
  @@map("ratings")
}

// Favorite drivers
model FavoriteDriver {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  driverId   String   @map("driver_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  driver   DriverProfile   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([merchantId, driverId])
  @@map("favorite_drivers")
}

// Driver incentives
model DriverIncentive {
  id            String          @id @default(uuid())
  driverId      String          @map("driver_id")
  incentiveType IncentiveType   @map("incentive_type")
  status        IncentiveStatus @default(pending)
  deliveredAt   DateTime?       @map("delivered_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  // Relations
  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_incentives")
}

enum IncentiveType {
  bag
  rain_cover
  box
  maintenance
  marchamo
}

enum IncentiveStatus {
  pending
  delivered
}

// Withdrawals
model Withdrawal {
  id            String           @id @default(uuid())
  driverId      String           @map("driver_id")
  amount        Decimal          @db.Decimal(10, 2)
  currency      String           @default("CRC")
  status        WithdrawalStatus @default(pending)
  paymentMethod WithdrawalMethod @map("payment_method")

  // SINPE details
  sinpePhone String? @map("sinpe_phone")
  sinpeName  String? @map("sinpe_name")

  // Bank transfer details
  bankName      String? @map("bank_name")
  accountNumber String? @map("account_number")
  accountHolder String? @map("account_holder")

  // Processing
  processedAt     DateTime? @map("processed_at")
  processedBy     String?   @map("processed_by")
  rejectionReason String?   @map("rejection_reason")
  transactionId   String?   @map("transaction_id")

  // Liquidación semanal (corte mar–lun, pago martes). Null = retiro manual
  // del repartidor fuera de planilla.
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  driver DriverProfile    @relation(fields: [driverId], references: [id])
  items  WithdrawalItem[]

  @@index([driverId, status, createdAt], map: "withdrawals_driver_status_created_idx")
  @@index([status, createdAt], map: "withdrawals_status_created_idx")
  @@index([periodStart], map: "withdrawals_period_start_idx")
  @@map("withdrawals")
}

// Líneas del recibo: qué viajes componen el retiro (monto congelado).
model WithdrawalItem {
  id           String     @id @default(uuid())
  withdrawalId String     @map("withdrawal_id")
  withdrawal   Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  orderId      String     @map("order_id")
  order        Order      @relation(fields: [orderId], references: [id])
  // Snapshot del payout al generar el recibo (no cambia si el pedido cambia).
  amount       Decimal    @db.Decimal(10, 2)
  deliveredAt  DateTime?  @map("delivered_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([withdrawalId, orderId], map: "withdrawal_items_withdrawal_order_uk")
  @@index([withdrawalId], map: "withdrawal_items_withdrawal_idx")
  @@map("withdrawal_items")
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
  rejected
}

enum WithdrawalMethod {
  sinpe
  bank_transfer
}

// Kioskos/puestos dentro de un comercio (ej. mercadito con varios
// productores, cada uno con su historia). El pedido del cliente junta
// productos de varios kioskos pero llega a UN comercio, que compra y reparte.
// Borrar un kiosko no borra sus productos (kioskId → null).
model MerchantKiosk {
  id          String   @id @default(uuid())
  merchantId  String   @map("merchant_id")
  name        String
  // Historia del puesto (la entrevista: cómo hacen el producto día a día).
  description String?
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items    MenuItem[]

  @@index([merchantId, active])
  @@map("merchant_kiosks")
}

// Menu Items
model MenuItem {
  id            String   @id @default(uuid())
  merchantId    String   @map("merchant_id")
  // Kiosko dueño del producto (null = directo del comercio).
  kioskId       String?  @map("kiosk_id")
  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  image         String?
  category      String
  isPopular     Boolean  @default(false) @map("is_popular")
  isAvailable   Boolean  @default(true) @map("is_available")
  // Días de la semana en que se ofrece (0=dom…6=sáb, hora Costa Rica).
  // Vacío = todos los días. Ej. rollos de canela solo jueves → [4].
  availableDays Int[]    @default([]) @map("available_days")
  // Stock por día de venta (ej. 50 rollos cada jueves). Null = sin límite.
  // dailyQty es el tamaño del lote: cada día CR nuevo el stock vuelve a ese
  // valor solo. stockDay guarda el día (YYYY-MM-DD CR) del stock vigente.
  stockQty      Int?     @map("stock_qty")
  dailyQty      Int?     @map("daily_qty")
  stockDay      String?  @map("stock_day")
  // Nota de entrega programada (ej. "Se entrega el jueves a las 2:00 p. m.").
  // Se muestra en la vitrina de mañana y en la preventa.
  fulfillNote   String?  @map("fulfill_note")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  merchant      MerchantProfile        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  kiosk         MerchantKiosk?         @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  orderItems    OrderItem[]
  variantGroups MenuItemVariantGroup[]

  @@index([merchantId, category])
  @@index([kioskId])
  @@map("menu_items")
}

// Modifier groups (tamaño, color, extras) defined per menu item
model MenuItemVariantGroup {
  id            String  @id @default(uuid())
  menuItemId    String  @map("menu_item_id")
  name          String
  required      Boolean @default(false)
  multiple      Boolean @default(false)
  // Tope de opciones elegibles (ej. "máximo 3 frutas"). Null = sin tope.
  maxSelections Int?    @map("max_selections")
  sortOrder     Int     @default(0) @map("sort_order")

  // Relations
  menuItem MenuItem                @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  MenuItemVariantOption[]

  @@map("menu_item_variant_groups")
}

model MenuItemVariantOption {
  id          String  @id @default(uuid())
  groupId     String  @map("group_id")
  name        String
  priceDelta  Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)
  sortOrder   Int     @default(0) @map("sort_order")
  isAvailable Boolean @default(true) @map("is_available")

  // Relations
  group MenuItemVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("menu_item_variant_options")
}

// Order Items (links orders to menu items)
model OrderItem {
  id               String   @id @default(uuid())
  orderId          String   @map("order_id")
  // Optional: null for custom items written by hand in the order wizard
  menuItemId       String?  @map("menu_item_id")
  name             String
  price            Decimal  @db.Decimal(10, 2)
  quantity         Int      @default(1)
  notes            String?
  // Snapshot of chosen variants [{group, option, priceDelta}]; price
  // already includes deltas, so totals never depend on live menu data.
  selectedVariants Json?    @map("selected_variants")
  // Snapshot del kiosko dueño del producto (para la lista de compras del
  // comercio). Null = directo del comercio o producto personalizado.
  kioskName        String?  @map("kiosk_name")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id])

  @@index([orderId], map: "order_items_order_idx")
  @@index([menuItemId], map: "order_items_menu_item_idx")
  @@map("order_items")
}

// Notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, type, createdAt], map: "notifications_user_type_created_idx")
  @@map("notifications")
}

/// Token FCM de un dispositivo. Uno por instalación de app/navegador.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String // ios | android | web
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// Suscripción del usuario a un topic de notificaciones (v2).
model TopicPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  topic     String // ver TOPIC_CATALOG en notifications.service.ts
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([topic, enabled])
  @@map("topic_preferences")
}

// Traffic history (time-series de condiciones viales por zona)
model TrafficHistory {
  id          String   @id @default(uuid())
  lat         Float
  lng         Float
  zone        String
  level       String
  speedFactor Float    @map("speed_factor")
  timestamp   DateTime @default(now())

  @@index([zone, timestamp])
  @@map("traffic_history")
}

// Traffic alerts (alertas manuales o por congestión)
model TrafficAlert {
  id                     String    @id @default(uuid())
  alertId                String    @unique @map("alert_id")
  type                   String
  severity               String
  title                  String
  message                String
  lat                    Float?
  lng                    Float?
  address                String?
  radiusKm               Float?    @map("radius_km")
  expiresAt              DateTime? @map("expires_at")
  alternativeDescription String?   @map("alternative_description")
  alternativeTimeSaved   Int?      @map("alternative_time_saved")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([expiresAt], map: "traffic_alerts_expires_idx")
  @@map("traffic_alerts")
}

// Per-driver read/dismiss state for traffic alerts
model TrafficAlertNotification {
  id        String   @id @default(uuid())
  driverId  String   @map("driver_id")
  alertId   String   @map("alert_id")
  read      Boolean  @default(false)
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([driverId, alertId])
  @@index([driverId, dismissed], map: "traffic_alert_notif_driver_dismissed_idx")
  @@index([alertId], map: "traffic_alert_notif_alert_idx")
  @@map("traffic_alert_notifications")
}

// Mensajes del formulario de contacto (landing pública, sin auth).
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  subject   String
  message   String
  status    String   @default("new") // new | read | resolved
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt], map: "contact_messages_status_created_idx")
  @@map("contact_messages")
}

// Idempotencia de webhooks Didit: event_id único por delivery (Didit
// reintenta 2 veces en 5xx/404; dos retries concurrentes no pasan dos veces).
model DiditWebhookEvent {
  eventId    String   @id @map("event_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("didit_webhook_events")
}

// Auditoría de asignación/concurso por pedido (quién, cuándo, resultado).
model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  type      String
  actorId   String?  @map("actor_id")
  driverId  String?  @map("driver_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_events")
}

// Zonas/barrios de entrega editables desde el admin (fuente de verdad del
// precio). `geometry` (GeoJSON Polygon/MultiPolygon) habilita el cobro por
// cercanía; sin geometría la zona es solo punto de referencia (referenceOnly).
model DeliveryZone {
  id            String   @id @default(uuid())
  label         String
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(10, 8)
  price         Decimal  @db.Decimal(10, 2)
  geometry      Json?
  referenceOnly Boolean  @default(true) @map("reference_only")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("delivery_zones")
}

// Deudas del negocio (ej. la moto sacada a mensualidades). Los pagos van a
// DebtPayment: cuotas normales, aportes de repartidores (Luis, Francisco…)
// y abonos extra a capital. Sin seed con montos: la deuda real la crea el
// admin en /admin/deudas con los números del contrato.
model Debt {
  id            String   @id @default(uuid())
  title         String
  description   String?
  // Costo total financiado (precio + intereses del contrato).
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  // Cuota mensual pactada.
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(10, 2)
  // Prima o abono inicial ya pagado al sacarla (no va en DebtPayment).
  downPayment   Decimal  @default(0) @map("down_payment") @db.Decimal(10, 2)
  startDate     DateTime @map("start_date")
  termMonths    Int?     @map("term_months")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  payments     DebtPayment[]
  participants DebtParticipant[]
  expenses     DebtExpense[]
  rentals      RentalContract[]

  @@map("debts")
}

model DebtPayment {
  id        String          @id @default(uuid())
  debtId    String          @map("debt_id")
  debt      Debt            @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal         @db.Decimal(10, 2)
  kind      DebtPaymentKind @default(cuota)
  // Aporte de repartidor: quién lo puso (opcional, ej. Luis o Francisco).
  driverId  String?         @map("driver_id")
  driver    DriverProfile?  @relation(fields: [driverId], references: [id])
  note      String?
  paidAt    DateTime        @default(now()) @map("paid_at")
  createdBy String?         @map("created_by")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([debtId, paidAt], map: "debt_payments_debt_paid_idx")
  @@map("debt_payments")
}

enum DebtPaymentKind {
  cuota // mensualidad normal
  aporte // aporte extra de repartidor/socio
  extra // abono extra a capital
}

// Repartidores asignados a pagar una deuda (los que la pagan con sus viajes).
// El aporte real queda en DebtPayment; esto es el roster de quiénes la pagan.
model DebtParticipant {
  id       String        @id @default(uuid())
  debtId   String        @map("debt_id")
  debt     Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  driverId String        @map("driver_id")
  driver   DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  joinedAt DateTime      @default(now()) @map("joined_at")

  @@unique([debtId, driverId], map: "debt_participants_debt_driver_uk")
  @@index([debtId], map: "debt_participants_debt_idx")
  @@map("debt_participants")
}

// Gastos de la moto/deuda: mantenimiento, seguro, gasolina, repuestos,
// marchamo, otro. La gasolina se puede ver por día/semana/mes desde el resumen.
model DebtExpense {
  id        String          @id @default(uuid())
  debtId    String          @map("debt_id")
  debt      Debt            @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal         @db.Decimal(10, 2)
  kind      DebtExpenseKind @default(otro)
  // Quién hizo el gasto (opcional, ej. gasolina cargada por un repartidor).
  driverId  String?         @map("driver_id")
  driver    DriverProfile?  @relation(fields: [driverId], references: [id])
  note      String?
  spentAt   DateTime        @default(now()) @map("spent_at")
  createdBy String?         @map("created_by")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([debtId, spentAt], map: "debt_expenses_debt_spent_idx")
  @@map("debt_expenses")
}

enum DebtExpenseKind {
  mantenimiento
  seguro
  gasolina
  repuesto
  marchamo
  otro
}

// Alquiler de la moto a repartidores (fase test: apagado por flag
// RENTALS_ENABLED). El contrato fija precio semanal y depósito; los pagos
// se registran acá. Nada de esto toca planilla: es libro aparte.
model RentalContract {
  id          String        @id @default(uuid())
  // Moto ligada (deuda origen, opcional: sirve para costear el precio).
  debtId      String?       @map("debt_id")
  debt        Debt?         @relation(fields: [debtId], references: [id])
  driverId    String        @map("driver_id")
  driver      DriverProfile @relation(fields: [driverId], references: [id])
  weeklyPrice Decimal       @map("weekly_price") @db.Decimal(10, 2)
  deposit     Decimal       @default(0) @db.Decimal(10, 2)
  startDate   DateTime      @map("start_date")
  endDate     DateTime?     @map("end_date")
  status      RentalStatus  @default(active)
  notes       String?
  createdBy   String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  payments RentalPayment[]

  @@index([driverId, status], map: "rental_contracts_driver_status_idx")
  @@map("rental_contracts")
}

enum RentalStatus {
  active
  finished
  cancelled
}

model RentalPayment {
  id         String         @id @default(uuid())
  contractId String         @map("contract_id")
  contract   RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amount     Decimal        @db.Decimal(10, 2)
  paidAt     DateTime       @default(now()) @map("paid_at")
  note       String?
  createdBy  String?        @map("created_by")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([contractId, paidAt], map: "rental_payments_contract_paid_idx")
  @@map("rental_payments")
}
