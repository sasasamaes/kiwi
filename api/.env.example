[TEMPLATE]
# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/kiwi"

# JWT — genera uno con: openssl rand -base64 48  (nunca uses valores de ejemplo en producción)
JWT_SECRET="CHANGE_ME_openssl_rand_base64_48"
# Access corto + refresh rotativo (opaco, 1 uso). El access lleva tokenVersion
# para revocación inmediata en logout.
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Compat legacy (ya no se usa para firmar; no lo configures en prod nuevo)
# JWT_EXPIRES_IN="7d"

# Rate limit compartido entre instancias (opcional). Sin esto, cada
# instancia cuenta por su cuenta y los límites se resetean con cada restart.
REDIS_URL=""

# Server
PORT=4000
NODE_ENV=development

# OnvoPay Payment Gateway
ONVO_SECRET_KEY=""
ONVO_PUBLISHABLE_KEY=""
ONVO_WEBHOOK_SECRET=""
ONVO_BASE_URL="https://api.onvopay.com/v1"

# Google Maps
GOOGLE_MAPS_API_KEY=""

# Crypto (Stellar)
STELLAR_NETWORK="testnet"
STELLAR_ISSUER=""

# Sentry (error tracking)
SENTRY_DSN=""

# CORS origins
CLIENT_URL="http://localhost:3002"
# Panel del comercio (retorno del checkout de recargas con tarjeta)
MERCHANT_URL="https://negocios.kiwicr.express"
WEB_URL="http://localhost:3000"
# Origen del frontend cliente (links de tracking y retornos Onvo)
FRONTEND_URL="https://www.kiwicr.express"

# Seed demo: en producción se exige SEED_DEMO_PASSWORD (mín 12) o el seed
# aborta. El E2E lo lee de E2E_PASSWORD. NUNCA '123456' en prod.
SEED_DEMO_PASSWORD=""
# Solo siembra con DB vacía. En prod requiere valor explícito 'true'.
SEED_DEMO_DATA="false"

# Subida de imágenes de producto (Cloudinary).
# Formato: cloudinary://api_key:api_secret@cloud_name
# Sin esta variable, /menu/my/image responde 503 y la app sigue con el picker de emojis.
CLOUDINARY_URL=""

# --- Didit KYC (verificación de identidad) ---
# API key de servidor (header x-api-key). NUNCA commitear ni exponer al browser.
DIDIT_API_KEY=""
# Secret compartido del webhook destination (firma HMAC X-Signature-V2).
DIDIT_WEBHOOK_SECRET=""
# --- Feature flags ---
# Verificación KYC obligatoria para repartidores (asignación de pedidos,
# retiros y visibilidad). false = el KYC se puede enviar y revisar pero
# NO bloquea nada (modo actual). true = bloquea.
KYC_REQUIRED=false
# Wallet receptora de pagos crypto (cuenta Stellar de Kiwi). Sin esta variable
# el método crypto se oculta del checkout y no se puede verificar on-chain.
# La cuenta receptora necesita trustline a USDC/USDT; su SECRET key (NUNCA en
# este repo) se custodia fuera del código.
STELLAR_RECEIVING_WALLET=""
# (Opcional) TTL del caché de tipo de cambio CRC/USD en ms. Default: 3600000 (1h).
# La cadena de fuentes es: Hacienda CR (oficial) → open.er-api.com → caché stale → constante.
FX_CACHE_TTL_MS=""
