[TEMPLATE]
# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/kiwi"

# JWT
JWT_SECRET="REDACTED-generate-with-openssl-rand"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# OnvoPay Payment Gateway
ONVO_SECRET_KEY=""
ONVO_PUBLISHABLE_KEY=""
ONVO_WEBHOOK_SECRET=""
ONVO_BASE_URL="https://api.onvopay.com/v1"

# Google Maps
GOOGLE_MAPS_API_KEY=""

# Crypto (Stellar)
STELLAR_NETWORK="testnet"
STELLAR_ISSUER=""

# Sentry (error tracking)
SENTRY_DSN=""

# CORS origins
CLIENT_URL="http://localhost:3002"
WEB_URL="http://localhost:3000"
