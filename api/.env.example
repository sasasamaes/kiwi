[TEMPLATE]
# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/kiwi"

# JWT
JWT_SECRET="REDACTED-generate-with-openssl-rand"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# OnvoPay
ONVOPAY_API_KEY=""
ONVOPAY_MERCHANT_ID=""

# Google Maps
GOOGLE_MAPS_API_KEY=""

# Crypto (Stellar)
STELLAR_NETWORK="testnet"
STELLAR_ISSUER=""

# Sentry (error tracking)
SENTRY_DSN=""

# CORS origins
CLIENT_URL="http://localhost:3002"
WEB_URL="http://localhost:3000"
