# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# App Configuration
NEXT_PUBLIC_APP_NAME=Kiwi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clave de acceso al playbook de ventas (/ventas?key=...). Server-side:
# la valida el middleware y el contenido nunca se envía sin autorización.
# Generar una real con: openssl rand -hex 16
# Definirla en Vercel (proyecto merchant) como VENTAS_ACCESS_KEY.
# Sin esta var, la puerta queda ABIERTA (solo para desarrollo).
VENTAS_ACCESS_KEY=cambiar-esta-clave-en-produccion
