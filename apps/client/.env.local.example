# Kiwi Client App Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# OnvoPay Configuration (publishable key — va en Vercel como env var, no aquí)
NEXT_PUBLIC_ONVO_PUBLISHABLE_KEY="onvo_test_publishable_key_xxx"

# App URLs
NEXT_PUBLIC_APP_NAME="Kiwi Delivery"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Environment
NODE_ENV="development"
