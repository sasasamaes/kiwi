{
  "expo": {
    "name": "Kiwi Clientes",
    "slug": "kiwi-clientes",
    "scheme": "kiwicliente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1326",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Kiwi usa la cámara para escanear el QR del comercio."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kiwi usa la cámara para tomar una foto.",
          "photosPermission": "Kiwi accede a tus fotos para que puedas adjuntar una imagen."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22c55e"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kiwi usa tu ubicación para mostrarte comercios cercanos y seguir tu pedido.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-web-browser",
      "@maplibre/maplibre-react-native"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "express.kiwicr.cliente",
      "adaptiveIcon": {
        "backgroundColor": "#0b1326",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e35687b8-b626-4678-b581-68f7a6a8d5e1"
      }
    },
    "owner": "neurapx"
  }
}
