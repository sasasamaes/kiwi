# Production Environment
API_URL=https://api.kiwi.app
SOCKET_URL=https://api.kiwi.app
APP_ENV=production

# Production Google Maps Key (restricted to production builds)
GOOGLE_MAPS_API_KEY=your_prod_google_maps_key

# Expo Project ID
EXPO_PROJECT_ID=your_prod_project_id

# Firebase Production
FIREBASE_API_KEY=prod_firebase_api_key
FIREBASE_AUTH_DOMAIN=kiwi.app
FIREBASE_PROJECT_ID=kiwi-prod
FIREBASE_STORAGE_BUCKET=kiwi-prod.appspot.com
FIREBASE_MESSAGING_SENDER_ID=prod_sender_id
FIREBASE_APP_ID=prod_app_id

# Sentry DSN
SENTRY_DSN=your_sentry_dsn
