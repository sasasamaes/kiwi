{
  "expo": {
    "name": "Kiwi Repartidores",
    "slug": "kiwi-repartidores",
    "scheme": "kiwirepartidor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1326",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kiwi usa la cámara para la foto de evidencia de entrega.",
          "photosPermission": "Kiwi accede a tus fotos para adjuntar la evidencia de entrega."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kiwi usa tu ubicación para mostrarte pedidos cercanos.",
          "locationAlwaysAndWhenInUsePermission": "Kiwi comparte tu ubicación mientras estás en línea para asignarte pedidos, incluso con la app en segundo plano.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "express.kiwicr.repartidor",
      "adaptiveIcon": {
        "backgroundColor": "#0b1326",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
